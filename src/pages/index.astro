      <nav>
        <a href="/discount" class="nav-discount">Get 50% off</a>
        <a href="#faq">FAQ</a>
        <a
          href="https://app.lemonsqueezy.com/my-orders/"
          target="_blank"
          rel="noopener">Recover Key</a
        >
      </nav>

      <div class="content">
        <Beaver />

        <div class="tagline">
          <h1>Nail Bite Beaver</h1>

          <p>
            Bite your nails or touch your face, and a beaver will appear and
            give you a warning - Kick your nail biting habit for good
          </p>

          <div class="download-cta">
            <a class="download-button" href={macDownloadHref} download>
              <svg
