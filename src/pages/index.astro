---
import Beaver from "../components/beaver.astro";
import Footer from "../components/Footer.astro";
import SocialMeta from "../components/SocialMeta.astro";

const macDownloadHref = "/downloads/NailBiteBeaver-1.0.dmg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <title>Nail Bite Beaver - Kick your nail biting habit for good</title>
    <SocialMeta
      title="Nail Bite Beaver"
      description="Kick your nail biting habit for good. A beaver appears on your Mac when you bite your nails or touch your face."
      path="/"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DM7ZR8WCHR"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-DM7ZR8WCHR");

      /**
       * Fire a custom GA4 event.
       * @param {string} eventName
       * @param {Record<string, string | number | boolean>} [params]
       */
      function trackEvent(eventName, params) {
        gtag("event", eventName, params);
      }
    </script>

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800&display=swap");

      html,
      body {
        overflow-x: hidden;
      }

      body {
        background: #f6ebda;
        color: #2c3e50;
        font-family: "Nunito", system-ui, sans-serif;
        font-weight: 500;
      }

      h1,
      h2,
      h3 {
        font-weight: 800;
      }

      .above-the-fold {
        height: 100vh;
      }

      .video--popout-container {
        position: absolute;
        right: -190px;
        top: 30%;
        transform: rotate(-32deg);
        width: 300px;
        height: 350px;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        transition: transform 180ms ease-out;
      }

      .video--popout {
        width: 150px;
        height: 300px;
        border-radius: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow:
          0 4px 6px -1px rgb(0 0 0 / 0.1),
          0 2px 4px -2px rgb(0 0 0 / 0.1);
        /* TODO: This should be proper thumbnail */
        background-image: url("");
        background-position: center;
        background-size: cover;
        cursor: pointer;
        transition: all 100ms linear;
      }

      .video--popout-container:hover,
      .video--popout-container:focus-visible {
        /* Slide a short way along the -32deg tilt, toward the label. */
        transform: translate(-10px, -16px) rotate(-32deg);
      }

      .video--popout:hover .video__play-button {
        background-color: rgba(44, 62, 80, 1);
      }

      .see-how-it-works-pointer {
        position: absolute;
        top: 33%;
        right: 120px;
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.02em;
        white-space: nowrap;
        transform: rotate(5deg);
      }

      .see-how-it-works-pointer svg {
        width: 56px;
        height: auto;
        transform: rotate(5deg);
      }

      .content {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 85ch;
        margin: 0 auto;
        height: 100%;
      }

      nav {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        padding-top: 12px;
        padding-left: 12px;
        padding-right: 12px;
        margin-bottom: 40px;
      }

      nav a {
        color: #2c3e50;
        font-weight: bold;
        text-decoration: none;
      }

      nav a.nav-discount {
        color: #5a6b7a;
        font-weight: 600;
      }

      nav a:hover,
      nav a:focus-visible {
        color: #263646;
        text-decoration: underline;
      }

      nav a.nav-discount:hover,
      nav a.nav-discount:focus-visible {
        color: #2c3e50;
      }

      .tagline {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        margin-top: 24px;
      }

      .tagline h1,
      .tagline p {
        text-align: center;
        max-width: 45ch;
      }

      .tagline h1 {
        font-size: 48px;
        margin: 0;
        line-height: 1;
      }

      .tagline p {
        font-size: 18px;
        margin: 0;
      }

      .download-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }

      .download-button {
        background: #c1763d;
        color: white;
        border: none;
        outline: none;
        border-radius: 6px;
        height: 55px;
        width: 240px;
        font-size: 18px;
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
      }

      .download-button:hover,
      .download-button:focus-visible {
        background: rgb(211, 125, 59);
        cursor: pointer;
      }

      .tagline .download-requirements,
      .download-requirements {
        margin: 0;
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
          "Liberation Mono", monospace;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.4;
        color: #5a6b7a;
        text-align: center;
      }

      .see-how-it-works-note {
        display: none;
      }

      /* TODO: This should potentially be the video element itself */
      .video {
        width: 260px;
        height: 460px;
        border-radius: 16px;
        display: none;
        justify-content: center;
        align-items: center;
        box-shadow:
          0 4px 6px -1px rgb(0 0 0 / 0.1),
          0 2px 4px -2px rgb(0 0 0 / 0.1);
        /* TODO: This should be proper thumbnail */
        background-image: url("https://slapmac.com/thumbFirstVideo.jpg");
        background-position: center;
        background-size: cover;
        cursor: pointer;
        margin-bottom: 2rem;
      }

      .video:hover .video__play-button {
        background-color: rgba(44, 62, 80, 1);
      }

      .video__play-button {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: rgba(44, 62, 80, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .menubar-card {
        width: 100%;
        max-width: 42rem;
        margin: 0 auto 1.5rem;
        padding: 2rem;
        background: #fff;
        border: 1px solid rgba(44, 62, 80, 0.1);
        border-radius: 16px;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
      }

      .menubar-card__heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: #2c3e50;
      }

      .menubar-card__heading svg {
        flex-shrink: 0;
        color: #c1763d;
      }

      .menubar-card__body {
        margin: 0.75rem 0 0;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: #5a6b7a;
      }

      .menubar-card__preview {
        display: flex;
        justify-content: center;
        margin-top: 1.5rem;
      }

      .menubar-card__preview img {
        width: 100%;
        max-width: 28rem;
        height: auto;
        border-radius: 8px;
      }

      .privacy-points {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
      }

      .privacy-points li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.9375rem;
        line-height: 1.45;
        color: #5a6b7a;
        font-weight: 500;
      }

      .privacy-points svg {
        flex-shrink: 0;
        margin-top: 0.1rem;
        color: #c1763d;
      }

      .privacy-card__link {
        display: inline-block;
        margin-top: 1.25rem;
        font-size: 0.875rem;
        font-weight: 700;
        color: #5a6b7a;
        text-underline-offset: 4px;
      }

      .privacy-card__link:hover,
      .privacy-card__link:focus-visible {
        color: #c1763d;
      }

      .make-a-reel-link {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        width: 100%;
        max-width: 42rem;
        margin: 2.5rem auto 3rem;
        padding: 32px;
        border: 1px dashed rgb(211, 125, 59);
        border-radius: 16px;
        text-align: center;
        text-decoration: none;
        color: #2c3e50;
        font-size: 18px;
        font-weight: bold;
        background: rgba(211, 125, 59, 0.2);
        box-sizing: border-box;
      }

      .make-a-reel-link__label {
        min-width: 0;
        text-wrap: balance;
      }

      .make-a-reel-link__name {
        white-space: nowrap;
      }

      .make-a-reel-link svg {
        flex-shrink: 0;
        transition: transform 100ms linear;
      }

      .make-a-reel-link:hover svg,
      .make-a-reel-link:focus-visible svg {
        transform: translateX(4px);
      }

      @media (max-width: 760px) {
        .tagline {
          box-sizing: border-box;
          width: 100%;
          padding-inline: 1.5rem;
        }

        .tagline h1 {
          text-wrap: balance;
        }

        .tagline p {
          text-wrap: pretty;
        }

        .menubar-card,
        .make-a-reel-link {
          box-sizing: border-box;
          width: calc(100% - 3rem);
          min-width: 0;
        }

        .make-a-reel-link {
          padding: 22px 20px;
          font-size: 15px;
          line-height: 1.35;
        }
      }

      @media (max-width: 340px) {
        .make-a-reel-link {
          padding: 20px 16px;
          font-size: 14px;
        }
      }

      @media (max-height: 680px) {
        .tagline h1 {
          font-size: 32px;
        }

        .tagline p {
          font-size: 14px;
        }

        .download-button {
          font-size: 14px;
          width: 180px;
          height: 40px;
        }
      }

      @media (max-width: 1020px) {
        .above-the-fold {
          height: auto;
          min-height: 100vh;
        }

        .see-how-it-works-pointer,
        .video--popout-container {
          display: none;
        }

        .see-how-it-works-note {
          display: flex;
          flex-direction: column;
          align-items: center;
          width: 260px;
          max-width: calc(100% - 1.5rem);
          margin: 1.75rem auto 0.7rem;
          font-size: 22px;
          font-weight: 800;
          line-height: 1;
          letter-spacing: -0.02em;
          text-align: center;
          white-space: nowrap;
          color: #2c3e50;
        }

        .see-how-it-works-note svg {
          width: 34px;
          height: auto;
          margin-top: 6px;
        }

        .video {
          display: flex;
        }
      }

      .pricing-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        max-width: 40rem;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 1rem;
        text-align: center;
      }

      .pricing-cta__headline {
        margin: 0;
        font-size: clamp(1.25rem, 3.5vw, 1.65rem);
        font-weight: 800;
        line-height: 1.35;
        letter-spacing: -0.02em;
        color: #2c3e50;
      }

      .faq {
        max-width: 42rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 5rem;
      }

      .faq__heading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin: 0 0 2.5rem;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        letter-spacing: -0.02em;
        text-align: center;
      }

      .faq__heading svg {
        flex-shrink: 0;
        color: #c1763d;
      }

      @media (max-width: 760px) {
        .faq__heading {
          gap: 0.35rem;
          font-size: clamp(1rem, 5vw, 1.75rem);
          line-height: 1.15;
          text-wrap: balance;
        }

        .faq__heading svg {
          width: 1.1em;
          height: 1.1em;
        }
      }

      .faq__list {
        margin: 0;
        padding: 0;
        border-top: 1px solid rgb(44 62 80 / 0.12);
      }

      .faq__item {
        border-bottom: 1px solid rgb(44 62 80 / 0.12);
        padding: 0.5rem 0.25rem;
      }

      .faq__question {
        margin: 0;
        font-size: inherit;
        font-weight: inherit;
      }

      .faq__trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        min-height: 44px;
        margin: 0;
        padding: 0.75rem 0.6rem;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #2c3e50;
        font: inherit;
        font-size: 1.125rem;
        font-weight: 800;
        line-height: 1.35;
        letter-spacing: -0.01em;
        text-align: left;
        cursor: pointer;
        transition-property: background-color, color;
        transition-duration: 150ms;
        transition-timing-function: ease-out;
      }

      .faq__trigger-label {
        text-wrap: balance;
      }

      .faq__trigger:hover {
        background-color: rgb(44 62 80 / 0.05);
      }

      .faq__trigger:active {
        background-color: rgb(44 62 80 / 0.08);
      }

      .faq__trigger:focus {
        outline: none;
      }

      .faq__trigger:focus-visible {
        outline: 2px solid #c1763d;
        outline-offset: 2px;
      }

      .faq__chevron {
        flex-shrink: 0;
        color: #c1763d;
        transition-property: transform;
        transition-duration: 220ms;
        transition-timing-function: ease-out;
      }

      .faq__trigger[aria-expanded="true"] .faq__chevron {
        transform: rotate(180deg);
      }

      .faq__panel {
        display: grid;
        grid-template-rows: 0fr;
        transition-property: grid-template-rows;
        transition-duration: 220ms;
        transition-timing-function: ease-out;
      }

      .faq__panel.is-open {
        grid-template-rows: 1fr;
      }

      .faq__panel[hidden] {
        display: none;
      }

      .faq__panel-inner {
        overflow: hidden;
        min-height: 0;
      }

      .faq__answer {
        margin: 0;
        padding: 0.2rem 0.6rem 1.05rem;
        font-size: 0.95rem;
        line-height: 1.6;
        color: #4a5968;
        text-wrap: pretty;
      }

      .faq__answer p {
        margin: 0;
      }

      .faq__answer p + p {
        margin-top: 0.85rem;
      }

      .faq__answer a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .faq__answer a:hover,
      .faq__answer a:focus-visible {
        color: #2c3e50;
      }

      @media (prefers-reduced-motion: reduce) {
        .faq__trigger,
        .faq__chevron,
        .faq__panel {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
