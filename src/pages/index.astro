    <script is:inline>
      document.querySelectorAll(".download-button").forEach((button) => {
        button.addEventListener("click", () => {
          trackEvent("download_click", { platform: "mac" });
        });
      });

      document
        .querySelector(".video--popout")
        ?.addEventListener("click", () => {
          trackEvent("video_click", { placement: "popout" });
        });

      document
        .querySelector("#see-how-it-works.video")
        ?.addEventListener("click", () => {
          trackEvent("video_click", { placement: "inline" });
        });

      document
        .querySelector(".make-a-reel-link")
        ?.addEventListener("click", () => {
          trackEvent("make_a_reel_click");
        });

      const faqMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const faqPanelDuration = 220;

      document.querySelectorAll(".faq__trigger").forEach((button) => {
        const panelId = button.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;

        let closeTimer = 0;

        const hideIfCollapsed = () => {
          if (button.getAttribute("aria-expanded") !== "true") {
            panel.hidden = true;
          }
        };

        button.addEventListener("click", () => {
          const expand = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", expand ? "true" : "false");
          window.clearTimeout(closeTimer);

          if (faqMotion.matches) {
            panel.classList.toggle("is-open", expand);
            panel.hidden = !expand;
            return;
          }

          if (expand) {
            panel.hidden = false;
            panel.getBoundingClientRect();
            panel.classList.add("is-open");
            return;
          }

          panel.classList.remove("is-open");
          closeTimer = window.setTimeout(
            hideIfCollapsed,
            faqPanelDuration + 40,
          );
          panel.addEventListener(
            "transitionend",
            (event) => {
              if (
                event.target !== panel ||
                event.propertyName !== "grid-template-rows"
              ) {
                return;
              }
              window.clearTimeout(closeTimer);
              hideIfCollapsed();
            },
            { once: true },
          );
        });
      });
    </script>
