<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__support">
      Contact support:{" "}
      <a href="mailto:support@nailbitebeaver.com">support@nailbitebeaver.com</a>
    </p>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/discount">Get 50% off</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid rgba(44, 62, 80, 0.12);
    padding: 2rem 1.5rem;
  }

  .site-footer__inner {
    max-width: 42rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .site-footer__support {
    margin: 0;
    font-size: 0.875rem;
    color: #5a6b7a;
  }

  .site-footer__support a {
    color: #2c3e50;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .site-footer__support a:hover,
  .site-footer__support a:focus-visible {
    color: #c1763d;
    text-decoration: underline;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-footer__nav a {
    color: #2c3e50;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: #c1763d;
    text-decoration: underline;
  }
</style>
