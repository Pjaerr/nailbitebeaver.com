---
interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const pageUrl = new URL(path, Astro.site);
const imageUrl = new URL("/og.png", Astro.site);
---

<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nail Bite Beaver" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<meta
  property="og:image:alt"
  content="Nail Bite Beaver, a cartoon beaver that helps you stop biting your nails"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta
  name="twitter:image:alt"
  content="Nail Bite Beaver, a cartoon beaver that helps you stop biting your nails"
/>
